#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "boto3",
#     "rich",
# ]
# ///

import datetime
import os
import sys
import threading
from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait

import boto3
import botocore
from rich.console import Console
from rich.progress import (
    BarColumn,
    MofNCompleteColumn,
    Progress,
    SpinnerColumn,
    TaskProgressColumn,
    TextColumn,
    TimeElapsedColumn,
)

console = Console()

# Parallel delete_objects calls in flight per phase. Each call removes up to
# 1000 keys, so 16 workers ~= 16k keys per round trip. Override with env var.
WORKERS = int(os.environ.get("S3_DELETE_WORKERS", "16"))
# Cap queued-but-not-started batches so listing doesn't buffer millions of keys.
MAX_INFLIGHT = WORKERS * 4


def bucket_region(client, bucket_name):
    """Resolve a bucket's region so we can target the right regional endpoint."""
    loc = client.get_bucket_location(Bucket=bucket_name)["LocationConstraint"]
    if loc is None:
        return "us-east-1"
    if loc == "EU":
        return "eu-west-1"
    return loc


def cached_object_count(bucket_name, region):
    """Best-effort object count from CloudWatch daily storage metrics.

    Same cached, ~1-day-stale number the S3 console shows. Returns None if the
    metric is unavailable (new bucket, no datapoint, or no permission).
    """
    try:
        cw = boto3.client("cloudwatch", region_name=region)
        now = datetime.datetime.now(datetime.timezone.utc)
        resp = cw.get_metric_statistics(
            Namespace="AWS/S3",
            MetricName="NumberOfObjects",
            Dimensions=[
                {"Name": "BucketName", "Value": bucket_name},
                {"Name": "StorageType", "Value": "AllStorageTypes"},
            ],
            StartTime=now - datetime.timedelta(days=3),
            EndTime=now,
            Period=86400,
            Statistics=["Average"],
        )
        points = sorted(resp["Datapoints"], key=lambda p: p["Timestamp"])
        return int(points[-1]["Average"]) if points else None
    except botocore.exceptions.ClientError:
        return None


def _object_batches(client, bucket_name):
    """Yield <=1000-key delete batches by streaming list_objects_v2 pages."""
    paginator = client.get_paginator("list_objects_v2")
    for page in paginator.paginate(Bucket=bucket_name):
        contents = page.get("Contents")
        if contents:
            yield [{"Key": o["Key"]} for o in contents]


def _version_batches(client, bucket_name):
    """Yield <=1000-key delete batches (versions + delete markers)."""
    paginator = client.get_paginator("list_object_versions")
    for page in paginator.paginate(Bucket=bucket_name):
        items = (page.get("Versions") or []) + (page.get("DeleteMarkers") or [])
        for i in range(0, len(items), 1000):
            yield [
                {"Key": v["Key"], "VersionId": v["VersionId"]}
                for v in items[i : i + 1000]
            ]


def _parallel_delete(client, bucket_name, batches, progress, task):
    """Delete batches concurrently, streaming from the batch generator.

    A producer (this thread) pulls list pages and submits delete_objects calls
    to a pool; workers run them in parallel. In-flight work is bounded so we
    never buffer the whole keyspace. Returns the total number of keys deleted.
    """
    lock = threading.Lock()
    deleted = 0

    def run(batch):
        nonlocal deleted
        resp = client.delete_objects(
            Bucket=bucket_name, Delete={"Objects": batch, "Quiet": True}
        )
        errors = resp.get("Errors")
        if errors:
            first = errors[0]
            raise RuntimeError(
                f"{len(errors)} key(s) failed to delete, e.g. "
                f"{first.get('Key')}: {first.get('Message')}"
            )
        with lock:
            deleted += len(batch)
            n = deleted
        total = progress.tasks[task].total
        if total is not None and n > total:
            progress.update(task, total=n)
        progress.update(task, completed=n)

    with ThreadPoolExecutor(max_workers=WORKERS) as pool:
        futures = set()
        for batch in batches:
            futures.add(pool.submit(run, batch))
            if len(futures) >= MAX_INFLIGHT:
                done, futures = wait(futures, return_when=FIRST_COMPLETED)
                for fut in done:
                    fut.result()  # surface worker exceptions promptly
        for fut in futures:
            fut.result()
    return deleted


def delete_bucket(base_client, bucket_name, progress, task):
    """Delete all objects, versions, and the bucket itself, driving the detail bar."""
    region = bucket_region(base_client, bucket_name)
    client = boto3.client("s3", region_name=region)

    approx = cached_object_count(bucket_name, region)
    progress.reset(task, total=approx, description=f"{bucket_name} — deleting objects")
    deleted = _parallel_delete(
        client, bucket_name, _object_batches(client, bucket_name), progress, task
    )
    progress.update(task, total=max(deleted, 1), completed=max(deleted, 1))

    progress.reset(
        task, total=None, description=f"{bucket_name} — deleting previous versions"
    )
    _parallel_delete(
        client, bucket_name, _version_batches(client, bucket_name), progress, task
    )

    progress.reset(task, total=1, description=f"{bucket_name} — deleting bucket")
    response = client.delete_bucket(Bucket=bucket_name)
    progress.update(task, completed=1)

    status = str(response["ResponseMetadata"]["HTTPStatusCode"])
    return status.startswith("2")


def main(bucket_names):
    if not bucket_names:
        console.print("[yellow]No buckets specified.[/yellow]")
        console.print("Usage: delete-buckets <bucket-name> [<bucket-name> ...]")
        return 1

    base_client = boto3.client("s3")

    with Progress(
        SpinnerColumn(),
        TextColumn("[bold blue]{task.description}"),
        BarColumn(),
        TaskProgressColumn(),
        MofNCompleteColumn(),
        TimeElapsedColumn(),
        console=console,
    ) as progress:
        overall_task = progress.add_task("Overall progress", total=len(bucket_names))
        detail_task = progress.add_task("Waiting", total=None)

        succeeded, skipped, failed = [], [], []

        for bucket_name in bucket_names:
            try:
                if delete_bucket(base_client, bucket_name, progress, detail_task):
                    succeeded.append(bucket_name)
                    console.log(f"[green]Successfully deleted[/green] {bucket_name}")
                else:
                    failed.append(bucket_name)
                    console.log(
                        f"[red]Unexpected response deleting[/red] {bucket_name}"
                    )
            except botocore.exceptions.ClientError as e:
                if e.response["Error"]["Code"] == "NoSuchBucket":
                    skipped.append(bucket_name)
                    console.log(f"[yellow]Not found, skipping[/yellow] {bucket_name}")
                else:
                    failed.append(bucket_name)
                    console.log(f"[red]Error deleting[/red] {bucket_name}: {e}")
            except Exception as e:  # e.g. partial delete_objects failures
                failed.append(bucket_name)
                console.log(f"[red]Error deleting[/red] {bucket_name}: {e}")
            finally:
                progress.advance(overall_task)

        progress.update(detail_task, description="Done")

    console.print(
        f"\n[bold]Summary:[/bold] "
        f"[green]{len(succeeded)} deleted[/green], "
        f"[yellow]{len(skipped)} skipped[/yellow], "
        f"[red]{len(failed)} failed[/red]"
    )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
