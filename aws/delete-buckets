#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "boto3",
#     "rich",
# ]
# ///

import datetime
import sys

import boto3
import botocore
from rich.console import Console
from rich.progress import (
    BarColumn,
    MofNCompleteColumn,
    Progress,
    SpinnerColumn,
    TaskProgressColumn,
    TextColumn,
    TimeElapsedColumn,
)

console = Console()


def bucket_region(s3, bucket_name):
    """Resolve a bucket's region for region-scoped CloudWatch queries."""
    loc = s3.meta.client.get_bucket_location(Bucket=bucket_name)["LocationConstraint"]
    # us-east-1 reports None; the legacy "EU" alias means eu-west-1.
    if loc is None:
        return "us-east-1"
    if loc == "EU":
        return "eu-west-1"
    return loc


def cached_object_count(bucket_name, region):
    """Best-effort object count from CloudWatch daily storage metrics.

    This is the same cached, ~1-day-stale number the S3 console shows. Returns
    None if the metric is unavailable (new bucket, no datapoint, no permission).
    """
    try:
        cw = boto3.client("cloudwatch", region_name=region)
        now = datetime.datetime.now(datetime.timezone.utc)
        resp = cw.get_metric_statistics(
            Namespace="AWS/S3",
            MetricName="NumberOfObjects",
            Dimensions=[
                {"Name": "BucketName", "Value": bucket_name},
                {"Name": "StorageType", "Value": "AllStorageTypes"},
            ],
            StartTime=now - datetime.timedelta(days=3),
            EndTime=now,
            Period=86400,
            Statistics=["Average"],
        )
        points = sorted(resp["Datapoints"], key=lambda p: p["Timestamp"])
        if not points:
            return None
        return int(points[-1]["Average"])
    except botocore.exceptions.ClientError:
        return None


def _delete_in_pages(pages, key_fn, bucket, progress, task):
    """Delete S3 objects/versions page by page, advancing a progress task.

    S3 lists at most 1000 keys per page, which is also the delete_objects
    batch limit, so each page maps to exactly one delete call. If the task has
    an (approximate) total and we exceed it, we bump the total so the bar never
    overflows past 100%.
    """
    count = 0
    for page in pages:
        keys = [key_fn(item) for item in page]
        if not keys:
            continue
        bucket.delete_objects(Delete={"Objects": keys, "Quiet": True})
        count += len(keys)
        task_total = progress.tasks[task].total
        if task_total is not None and count > task_total:
            progress.update(task, total=count)
        progress.update(task, completed=count)
    return count


def delete_bucket(s3, bucket_name, progress, task):
    """Delete all objects, versions, and the bucket itself, driving the detail bar."""
    bucket = s3.Bucket(bucket_name)

    approx = cached_object_count(bucket_name, bucket_region(s3, bucket_name))
    progress.reset(task, total=approx, description=f"{bucket_name} — deleting objects")
    deleted = _delete_in_pages(
        bucket.objects.pages(), lambda o: {"Key": o.key}, bucket, progress, task
    )
    # Snap the bar to 100% (the cached count is only approximate).
    progress.update(task, total=max(deleted, 1), completed=max(deleted, 1))

    progress.reset(
        task, total=None, description=f"{bucket_name} — deleting previous versions"
    )
    _delete_in_pages(
        bucket.object_versions.pages(),
        lambda v: {"Key": v.object_key, "VersionId": v.id},
        bucket,
        progress,
        task,
    )

    progress.reset(task, total=1, description=f"{bucket_name} — deleting bucket")
    response = bucket.delete()
    progress.update(task, completed=1)

    status = str(response["ResponseMetadata"]["HTTPStatusCode"])
    return status.startswith("2")


def main(bucket_names):
    if not bucket_names:
        console.print("[yellow]No buckets specified.[/yellow]")
        console.print("Usage: delete-buckets <bucket-name> [<bucket-name> ...]")
        return 1

    s3 = boto3.resource("s3")

    with Progress(
        SpinnerColumn(),
        TextColumn("[bold blue]{task.description}"),
        BarColumn(),
        TaskProgressColumn(),
        MofNCompleteColumn(),
        TimeElapsedColumn(),
        console=console,
    ) as progress:
        overall_task = progress.add_task("Overall progress", total=len(bucket_names))
        detail_task = progress.add_task("Waiting", total=None)

        succeeded, skipped, failed = [], [], []

        for bucket_name in bucket_names:
            try:
                if delete_bucket(s3, bucket_name, progress, detail_task):
                    succeeded.append(bucket_name)
                    console.log(f"[green]Successfully deleted[/green] {bucket_name}")
                else:
                    failed.append(bucket_name)
                    console.log(
                        f"[red]Unexpected response deleting[/red] {bucket_name}"
                    )
            except botocore.exceptions.ClientError as e:
                if e.response["Error"]["Code"] == "NoSuchBucket":
                    skipped.append(bucket_name)
                    console.log(f"[yellow]Not found, skipping[/yellow] {bucket_name}")
                else:
                    failed.append(bucket_name)
                    console.log(f"[red]Error deleting[/red] {bucket_name}: {e}")
            finally:
                progress.advance(overall_task)

        progress.update(detail_task, description="Done")

    console.print(
        f"\n[bold]Summary:[/bold] "
        f"[green]{len(succeeded)} deleted[/green], "
        f"[yellow]{len(skipped)} skipped[/yellow], "
        f"[red]{len(failed)} failed[/red]"
    )
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
